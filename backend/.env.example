# Set only in Railway/server environment, never in frontend build variables.
OPENAI_API_KEY=
# Use an OpenAI model that supports chat completions with strict Structured Outputs.
OPENAI_MODEL=
# Private access code entered into the app by approved users. Choose a long random value.
STUDIO_ACCESS_TOKEN=
# Needed only for separately deployed frontend. Single-service deployment is same-origin.
CORS_ORIGINS=http://localhost:5173
