# Set only in Railway/server environment, never in frontend build variables.
# Preferred provider for this project. Gemini is recommended.
AI_PROVIDER=gemini

# Google Gemini API key created in Google AI Studio.
GEMINI_API_KEY=
# Example current model for new projects. You can change this in Railway without editing code.
GEMINI_MODEL=gemini-3.8-flash

# Optional legacy OpenAI fallback. Used only when AI_PROVIDER=openai or Gemini variables are absent.
OPENAI_API_KEY=
OPENAI_MODEL=

# Private access code entered into the app by approved users. Choose a long random value.
STUDIO_ACCESS_TOKEN=

# Needed only for separately deployed frontend. Single-service deployment is same-origin.
CORS_ORIGINS=http://localhost:5173
